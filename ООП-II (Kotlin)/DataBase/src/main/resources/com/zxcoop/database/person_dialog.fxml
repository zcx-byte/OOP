<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.zxcoop.database.controller.PersonDialogController"
          hgap="10" vgap="10"
          style="-fx-padding: 20;">

    <Label text="ФИО:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" promptText="Иванов Иван Иванович"
               GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

    <Label text="Возраст:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <Spinner fx:id="ageField" editable="true" min="0" max="150" initialValue="18"
             GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Дата рождения:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dateField"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Телефон:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="phoneField" promptText="+7 (999) 123-45-67"
               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

</GridPane>